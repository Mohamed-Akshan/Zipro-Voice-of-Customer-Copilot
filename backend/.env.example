APP_NAME=Zipro Voice of Customer Copilot
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna



EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# Database (psycopg URL)
DATABASE_URL=

# Pinecone serverless index
PINECONE_API_KEY=
PINECONE_INDEX=zipro-feedback
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Cohere reranking; can be omitted for a reduced-quality local test
COHERE_API_KEY=
COHERE_MODEL=rerank-v5.0-fast

# Optional
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MAX_UPLOAD_MB=8

# Safe Pinecone ingestion, tune after checking provider quotas
INGEST_BATCH_SIZE=20
INGEST_DELAY_SECONDS=2
INGEST_RETRIES=3
INGEST_RETRY_SECONDS=65
